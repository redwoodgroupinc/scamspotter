# ---------------------------------------------------------------------------
# ScamSpotter environment variables
# Copy this file to `.env.local` for local development. On Cloudflare, add
# these as build variables (Worker -> Settings -> Build -> Variables and
# secrets); on Vercel, under Project Settings -> Environment Variables.
# They are read at build time. Every variable is optional: the site builds and
# works without any of them.
# ---------------------------------------------------------------------------

# Canonical site URL used for canonical tags, the sitemap, robots.txt and
# Open Graph URLs. Defaults to https://scamspotter.net when unset.
# Leave it unset for launch. Only change it if the site will live on a
# different domain.
NEXT_PUBLIC_SITE_URL=https://scamspotter.net

# Public contact address shown on the Contact page. Leave empty until you have
# a mailbox that is actually monitored.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense. Leave ALL of these empty until your site has been approved.
# When NEXT_PUBLIC_ADSENSE_CLIENT is empty, no AdSense script is loaded and no
# ad containers are rendered.
#
# Publisher ID format: ca-pub- followed by digits (copy it from AdSense).
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit (slot) IDs are numeric. Create display ad units in AdSense and paste
# their data-ad-slot values here.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
# Optional: a separate unit for the homepage. Falls back to the article slot.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# Optional: Google Search Console HTML-tag verification token (the value of
# the content="..." attribute only). Not needed if you verify via DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
